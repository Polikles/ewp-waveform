{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EWP Waveform Visual Preset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "canvas",
    "waveform",
    "signal",
    "effects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "waveform": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "style",
        "color",
        "amplitude"
      ],
      "properties": {
        "style": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        },
        "amplitude": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stroke_width": {
          "type": "number",
          "minimum": 0
        },
        "center_line": {
          "type": "boolean"
        },
        "domain": {
          "enum": [
            "time",
            "frequency"
          ]
        },
        "time_mode": {
          "enum": [
            "scroll",
            "playhead"
          ]
        },
        "window_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "normalization"
      ],
      "properties": {
        "scale": {
          "type": "string"
        },
        "smoothing": {
          "type": "number",
          "minimum": 0,
          "description": "Optional Gaussian-approx envelope blur in seconds. 0 disables."
        },
        "classic_alternate_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.25,
          "description": "Opacity of classic scroll bars inserted into the former gaps. Default 0.25; 0 restores empty gaps."
        },
        "envelope_oversample": {
          "type": "integer",
          "enum": [
            1,
            2,
            4,
            8
          ],
          "description": "Real RMS bins per output pixel across window_seconds. Not interpolated 1x data."
        },
        "envelope_aa": {
          "type": "string",
          "enum": [
            "none",
            "area",
            "lanczos"
          ],
          "description": "Reconstruction filter on the dense envelope, matched to output pixel width. Independent of smoothing."
        },
        "envelope_aa_support": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Filter support in output pixels. Area: box width. Lanczos: a."
        },
        "shutter_degrees": {
          "type": "number",
          "minimum": 0,
          "description": "Temporal shutter in degrees. 60 is a light default; 0 disables."
        },
        "envelope_motion_lpf": {
          "type": "string",
          "enum": [
            "none",
            "sinc",
            "gaussian"
          ],
          "description": "Temporal-Nyquist low-pass on envelope amplitude vs X. Adaptive with fps and scroll speed."
        },
        "envelope_motion_cutoff": {
          "type": "number",
          "minimum": 0,
          "description": "Explicit cutoff in cycles per output pixel. 0 derives fps/(2*velocity)*margin."
        },
        "envelope_motion_margin": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Safety factor on the derived temporal Nyquist. 0.85 \u2192 ~0.09 cyc/px at default scroll."
        },
        "shutter_mix": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Weight of the temporally filtered frame mixed into the sharp base."
        },
        "normalization": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "none",
                "auto",
                "project",
                "reference"
              ]
            },
            "soft_clip": {
              "type": "boolean"
            }
          }
        },
        "frequency": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "range": {
              "enum": [
                "auto",
                "project"
              ]
            },
            "fmin_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fmax_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "fixed_axis_profile": {
          "description": "Opt-in stationary center-out filled ribbon visual bundle, not a performance setting.",
          "enum": [
            "filled-ribbon-v1",
            "filled-ribbon-v2"
          ]
        },
        "detail_level": {
          "enum": [
            "smooth",
            "balanced",
            "detailed"
          ],
          "description": "Refined filled-ribbon-v2 only; default balanced."
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "glow",
        "particles"
      ],
      "properties": {
        "glow": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "enabled",
            "level"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "level": {
              "enum": [
                "none",
                "low",
                "medium",
                "high"
              ]
            },
            "color": {
              "type": "string"
            }
          }
        },
        "particles": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "motion": {
              "type": "string"
            },
            "interaction": {
              "type": "string"
            },
            "density": {
              "type": "number",
              "minimum": 0
            },
            "intensity": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "signal": {
            "required": [
              "fixed_axis_profile"
            ]
          }
        },
        "required": [
          "signal"
        ]
      },
      "then": {
        "properties": {
          "waveform": {
            "required": [
              "domain"
            ],
            "properties": {
              "domain": {
                "const": "frequency"
              },
              "style": {
                "const": "filled"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "signal": {
            "required": [
              "detail_level"
            ]
          }
        },
        "required": [
          "signal"
        ]
      },
      "then": {
        "properties": {
          "signal": {
            "required": [
              "fixed_axis_profile"
            ],
            "properties": {
              "fixed_axis_profile": {
                "const": "filled-ribbon-v2"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "signal": {
            "required": [
              "fixed_axis_profile"
            ],
            "properties": {
              "fixed_axis_profile": {
                "const": "filled-ribbon-v2"
              }
            }
          }
        },
        "required": [
          "signal"
        ]
      },
      "then": {
        "properties": {
          "waveform": {
            "additionalProperties": false,
            "properties": {
              "style": {
                "type": "string",
                "minLength": 1
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
              },
              "amplitude": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 1
              },
              "stroke_width": {
                "type": "number",
                "minimum": 1,
                "maximum": 12
              },
              "center_line": {
                "type": "boolean"
              },
              "domain": {
                "enum": [
                  "time",
                  "frequency"
                ]
              },
              "time_mode": false,
              "window_seconds": {
                "const": 5
              }
            }
          },
          "signal": {
            "additionalProperties": false,
            "properties": {
              "fixed_axis_profile": {
                "description": "Opt-in stationary center-out filled ribbon visual bundle, not a performance setting.",
                "enum": [
                  "filled-ribbon-v1",
                  "filled-ribbon-v2"
                ]
              },
              "detail_level": {
                "enum": [
                  "smooth",
                  "balanced",
                  "detailed"
                ],
                "description": "Refined filled-ribbon-v2 only; default balanced."
              },
              "scale": {
                "type": "string"
              },
              "smoothing": {
                "type": "number",
                "minimum": 0,
                "description": "Optional Gaussian-approx envelope blur in seconds. 0 disables."
              },
              "normalization": {
                "type": "object",
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "none",
                      "auto",
                      "project",
                      "reference"
                    ]
                  },
                  "soft_clip": {
                    "type": "boolean"
                  }
                }
              },
              "frequency": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "range": {
                    "enum": [
                      "auto",
                      "project"
                    ]
                  },
                  "fmin_hz": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "fmax_hz": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          },
          "effects": {
            "additionalProperties": false,
            "properties": {
              "glow": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "enabled",
                  "level"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "level": {
                    "enum": [
                      "none",
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "color": {
                    "type": "string"
                  }
                }
              },
              "particles": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "motion": {
                    "type": "string"
                  },
                  "interaction": {
                    "type": "string"
                  },
                  "density": {
                    "type": "number",
                    "minimum": 0
                  },
                  "intensity": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
