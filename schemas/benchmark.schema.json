{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EWP Waveform Benchmark Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "name",
    "inputs",
    "variants",
    "benchmark"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "preset": {
            "type": "string"
          },
          "preset_file": {
            "type": "string"
          },
          "overrides": {
            "type": "object"
          }
        }
      }
    },
    "benchmark": {
      "type": "object",
      "required": [
        "renderers",
        "formats"
      ],
      "properties": {
        "renderers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "performance_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dry_run_estimates": {
          "type": "boolean"
        }
      }
    }
  }
}
