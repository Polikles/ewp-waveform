{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EWP Waveform Performance Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "processing",
    "workdirs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_seconds",
        "jobs",
        "ffmpeg_threads"
      ],
      "properties": {
        "chunk_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "jobs": {
          "type": "integer",
          "minimum": 1
        },
        "ffmpeg_threads": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "workdirs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persistent",
        "keep_on_success",
        "keep_on_failure"
      ],
      "properties": {
        "persistent": {
          "type": "boolean"
        },
        "keep_on_success": {
          "type": "boolean"
        },
        "keep_on_failure": {
          "type": "boolean"
        },
        "root": {
          "type": "string"
        }
      }
    }
  }
}
