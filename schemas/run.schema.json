{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EWP Waveform Run Summary",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "tool",
    "counts",
    "jobs",
    "timestamps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "tool": {
      "type": "object"
    },
    "counts": {
      "type": "object",
      "required": [
        "jobs",
        "succeeded",
        "skipped",
        "failed"
      ],
      "properties": {
        "jobs": {
          "type": "integer",
          "minimum": 0
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "jobs": {
      "type": "array"
    },
    "timestamps": {
      "type": "object",
      "required": [
        "started_at",
        "completed_at"
      ]
    }
  }
}
